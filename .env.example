# Non-secret runtime settings. This project does not load .env files itself.
# Export these variables in the process environment when overriding defaults.
SCG_PROVIDER=claude-cli
SCG_CLAUDE_CMD=
SCG_MODEL=
SCG_TIMEOUT_MS=1800000
SCG_STAGING_CAP=4
SCG_DEDUP_MIN_SHARED=4
SCG_DEDUP_FRACTION=0.4
SCG_SOURCE_PRIOR_SURVIVORS=0.5
SCG_SOURCE_PRIOR_NONSURVIVORS=3
SCG_SOURCE_WEIGHT=0.7
SCG_SOURCE_CAP_POSITIVE=0.15
SCG_SOURCE_CAP_NEGATIVE=-0.10
SCG_DRAW_FLOOR=0.2

# Provider authentication is intentionally not represented here. The default
# provider uses an already-authenticated Claude Code CLI session and never
# reads or stores an API key in this repository.

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentra.local/schemas/mechanism-invention-output-v1.json",
  "title": "Mechanism Invention Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "concepts", "no_concept_reason"],
  "properties": {
    "schema_version": { "const": "mechanism-invention-output-v1" },
    "concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" } },
    "no_concept_reason": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "concepts": { "maxItems": 0 } } },
      "then": { "properties": { "no_concept_reason": { "type": "string", "minLength": 1 } } },
      "else": { "properties": { "no_concept_reason": { "type": "null" } } }
    }
  ],
  "$defs": {
    "concept": {
      "type": "object",
      "required": [
        "id", "slot", "concept", "economic_counterparty", "persistence_reason",
        "cheapest_falsifier", "transmission_channel", "falsifier_spec",
        "evidence_refs", "mechanism_atoms"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slot": { "type": "string", "minLength": 1 },
        "concept": { "type": "string", "minLength": 1 },
        "economic_counterparty": { "type": "string", "minLength": 1 },
        "persistence_reason": { "type": "string", "minLength": 1 },
        "cheapest_falsifier": { "type": "string", "minLength": 1 },
        "transmission_channel": { "type": "string", "minLength": 1 },
        "falsifier_spec": { "type": "object" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "mechanism_atoms": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    }
  }
}

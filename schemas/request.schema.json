{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentra.local/schemas/concept-generator-request-v1.json",
  "title": "Sentra Concept Generator Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "generated_at",
    "max_concepts",
    "transmitted_sources",
    "rotation",
    "lessons"
  ],
  "properties": {
    "schema_version": { "const": "sentra-concept-generator-request-v1" },
    "request_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "max_concepts": { "type": "integer", "minimum": 1, "maximum": 20 },
    "staging_cap": { "type": "integer", "minimum": 0, "maximum": 20 },
    "transmitted_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transmittedSource" }
    },
    "rotation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "concept": { "type": "string" },
          "source_class": {}
        }
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "mechanism", "steering"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "mechanism": { "type": "string", "minLength": 1 },
          "scope": { "type": "string" },
          "cause_of_death": { "type": "string" },
          "cause_class": { "type": ["string", "null"] },
          "steering": {
            "type": "object",
            "required": ["mode", "text"],
            "properties": {
              "mode": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "weight": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "packet": {
      "type": "object",
      "required": [
        "packet_id",
        "evidence_tier",
        "claim_scope",
        "passage",
        "passage_sha256",
        "start_offset",
        "end_offset",
        "locator_type",
        "locator_value",
        "source_file_sha256",
        "normalized_content_sha256",
        "extraction_method"
      ],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "evidence_tier": { "enum": ["ABSTRACT", "TRANSCRIPT", "FULL_TEXT"] },
        "claim_scope": { "enum": ["ABSTRACT_ONLY", "SOURCE_PASSAGE"] },
        "passage": { "type": "string", "minLength": 1 },
        "passage_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "start_offset": { "type": "integer", "minimum": 0 },
        "end_offset": { "type": "integer", "minimum": 0 },
        "locator_type": { "enum": ["PARAGRAPH_SENTENCE", "SECTION_PARAGRAPH", "TRANSCRIPT_TIMESTAMP", "TRANSCRIPT_SEGMENT"] },
        "locator_value": { "type": "string", "minLength": 1 },
        "source_file_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "normalized_content_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "extraction_method": { "type": "string", "minLength": 1 }
      }
    },
    "transmittedSource": {
      "type": "object",
      "required": ["record", "packets"],
      "properties": {
        "record": {
          "type": "object",
          "required": ["source_id", "source_title", "source_class", "track", "topic", "content_tier", "extraction_status", "packets"],
          "properties": {
            "source_id": { "type": "string", "minLength": 1 },
            "source_title": { "type": "string", "minLength": 1 },
            "source_class": { "type": "string", "minLength": 1 },
            "track": { "type": "string", "minLength": 1 },
            "topic": { "type": "string", "minLength": 1 },
            "canonical_url": { "type": ["string", "null"] },
            "source_path": { "type": "string" },
            "content_tier": { "type": "string", "minLength": 1 },
            "extraction_status": { "const": "READY" },
            "packets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packet" } }
          }
        },
        "packets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packet" } }
      }
    }
  }
}
